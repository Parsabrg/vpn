@@ -0,0 +1,73 @@
+package dev.amirzr.flutter_v2ray_client.v2ray.services;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.ResultReceiver;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import dev.amirzr.flutter_v2ray_client.v2ray.core.V2rayCoreManager;
+
+/**
+ * Runs Xray's delay test in the daemon process, beside the tunnel's own Xray,
+ * never in the app's process.
+ *
+ * Measured in the app's process, the test loaded Xray's Go runtime there; the
+ * WireGuard backend then loaded its own Go runtime into the same process, and
+ * the app died with SIGSEGV the moment WireGuard came up. Two Go runtimes in
+ * one process is not supported. Seen on a phone: test the protocols, then
+ * connect with WireGuard.
+ */
+public class DelayProbeService extends Service {
+    public static final String EXTRA_CONFIG = "config";
+    public static final String EXTRA_URL = "url";
+    public static final String EXTRA_RECEIVER = "receiver";
+    public static final String RESULT_DELAY = "delay";
+
+    private final ExecutorService executor = Executors.newCachedThreadPool();
+    private final AtomicInteger running = new AtomicInteger();
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        if (intent == null) {
+            return START_NOT_STICKY;
+        }
+        final String config = intent.getStringExtra(EXTRA_CONFIG);
+        final String url = intent.getStringExtra(EXTRA_URL);
+        final ResultReceiver receiver = intent.getParcelableExtra(EXTRA_RECEIVER);
+        running.incrementAndGet();
+        executor.submit(() -> {
+            long delay = -1L;
+            try {
+                delay = V2rayCoreManager.getInstance().getV2rayServerDelay(this, config, url);
+            } catch (Exception ignored) {
+                // -1 is the answer for anything that did not come back.
+            } finally {
+                if (receiver != null) {
+                    final Bundle data = new Bundle();
+                    data.putLong(RESULT_DELAY, delay);
+                    receiver.send(0, data);
+                }
+                if (running.decrementAndGet() == 0) {
+                    stopSelf();
+                }
+            }
+        });
+        return START_NOT_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        executor.shutdown();
+        super.onDestroy();
+    }
+}
