+package dev.amirzr.flutter_v2ray_client.v2ray.services;
+
+/**
+ * hev-socks5-tunnel, the bridge from the VPN interface to the engine's local
+ * SOCKS5 proxy. It runs in this process on its own thread; these are its JNI
+ * entry points, registered by the library against this class's name (built
+ * with PKGNAME/CLSNAME set to it -- see third_party_src/vendor_plugin.py).
+ *
+ * It replaced badvpn's tun2socks, which v2rayNG had also dropped: after a
+ * long session the tunnel read "connected" and carried nothing, while the
+ * same server kept working in v2rayNG on hev.
+ */
+public final class TProxyService {
+    static {
+        System.loadLibrary("hev-socks5-tunnel");
+    }
+
+    private TProxyService() {
+    }
+
+    public static native boolean TProxyStartService(String configPath, int fd);
+
+    public static native boolean TProxyStopService();
+
+    public static native boolean TProxyIsRunning();
+
+    public static native long[] TProxyGetStats();
+}
