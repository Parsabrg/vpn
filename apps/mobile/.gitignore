# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Regenerated by third_party_src/vendor_plugin.py -- the patch and the
# pinned binary digests are tracked, the ~145MB result is not.
/third_party/*
!/third_party/flutter_secure_storage_windows/
!/third_party/flutter_secure_storage_windows/**
/assets/windows_runtime/*
!/assets/windows_runtime/.gitkeep
/assets/linux_runtime/*
!/assets/linux_runtime/.gitkeep

# Portable-build output. `dist/` alone does not match these: every Windows
# build so far has gone to its own `dist-<something>/`, and there are 2.7 GB
# of them here. Left untracked rather than deleted -- they are somebody's
# build outputs, not this repository's business.
/dist-*/

# Generated from lib/l10n/*.arb by `flutter pub get` (pubspec `generate: true`).
# Not committed, so the ARB files stay the only place copy is written and the
# two cannot drift apart. Every CI job runs `flutter pub get` first, which is
# what produces these.
lib/l10n/app_localizations*.dart
