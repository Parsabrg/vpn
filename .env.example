# Copy to .env for local development only. Never commit the copied file.

# Application
NEBULA_ENV=development
NEBULA_LOG_LEVEL=INFO
NEBULA_API_PUBLIC_URL=http://localhost:8000
NEBULA_ADMIN_PUBLIC_URL=http://localhost:3000
NEBULA_ALLOWED_ORIGINS=http://localhost:3000
# Must match NEBULA_ALLOWED_ORIGINS above: the admin app presents this as its
# own Origin header when it calls the API server-to-server (mutations only),
# since FastAPI's CSRF/origin check has no browser-supplied Origin to read.
NEBULA_ADMIN_ORIGIN=http://localhost:3000

# PostgreSQL and Redis
POSTGRES_DB=nebula
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-local-superuser-only
NEBULA_DB_APP_USER=nebula_app
NEBULA_DB_APP_PASSWORD=replace-local-app-only
NEBULA_DB_MIGRATOR_USER=nebula_migrator
NEBULA_DB_MIGRATOR_PASSWORD=replace-local-migrator-only
NEBULA_DATABASE_URL=postgresql+psycopg://nebula_app:replace-local-app-only@postgres:5432/nebula
MIGRATION_DATABASE_URL=postgresql+psycopg://nebula_migrator:replace-local-migrator-only@postgres:5432/nebula
NEBULA_REDIS_URL=redis://redis:6379/0

# Authentication (production uses mounted files or a secret manager)
NEBULA_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
NEBULA_JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
NEBULA_TOKEN_PEPPER_FILE=/run/secrets/token_pepper
NEBULA_MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa_encryption_key
NEBULA_PROTOCOL_CREDENTIAL_KEY_FILE=/run/secrets/protocol_credential_key
NEBULA_ACCESS_TOKEN_TTL_SECONDS=900
NEBULA_REFRESH_TOKEN_TTL_DAYS=30
NEBULA_ACTIVATION_TOKEN_TTL_HOURS=24
NEBULA_ACCOUNT_REQUEST_TTL_DAYS=7
NEBULA_DEFAULT_DEVICE_LIMIT=3
NEBULA_PASSWORD_RESET_TTL_MINUTES=30
NEBULA_ADMIN_SESSION_TTL_MINUTES=30
NEBULA_ADMIN_SESSION_ABSOLUTE_TTL_HOURS=8
NEBULA_ADMIN_PREAUTH_TTL_MINUTES=5
NEBULA_ADMIN_STEP_UP_TTL_MINUTES=5
NEBULA_TOTP_ALLOWED_SKEW_STEPS=1
NEBULA_AUTH_RATE_WINDOW_SECONDS=900
NEBULA_USER_LOGIN_RATE_LIMIT=10
NEBULA_ADMIN_LOGIN_RATE_LIMIT=5
NEBULA_ADMIN_MFA_RATE_LIMIT=5
NEBULA_PASSWORD_RESET_RATE_LIMIT=5
NEBULA_ACCOUNT_REQUEST_RATE_LIMIT=5
NEBULA_ACCOUNT_REQUEST_REVIEW_RATE_LIMIT=20
NEBULA_ADMIN_USER_MUTATION_RATE_LIMIT=20
NEBULA_ADMIN_LOCKOUT_THRESHOLD=5
NEBULA_ADMIN_LOCKOUT_SECONDS=900

# Initial administrator (password is entered interactively by the seed command)
NEBULA_ADMIN_EMAIL=admin@example.com

# Email: smtp or resend
NEBULA_EMAIL_PROVIDER=smtp
NEBULA_EMAIL_FROM=Nebula VPN <no-reply@example.com>
NEBULA_SMTP_HOST=mailpit
NEBULA_SMTP_PORT=1025
NEBULA_SMTP_USERNAME=
NEBULA_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
NEBULA_SMTP_STARTTLS=false
NEBULA_RESEND_API_KEY_FILE=/run/secrets/resend_api_key

# API-to-agent mutual TLS (API-side client identity; Phase 1.6b)
NEBULA_VPN_AGENT_URL=https://vpn-agent:9443
NEBULA_AGENT_CA_FILE=/run/secrets/agent_ca
NEBULA_AGENT_CLIENT_CERT_FILE=/run/secrets/agent_client_cert
NEBULA_AGENT_CLIENT_KEY_FILE=/run/secrets/agent_client_key

# Agent-side mTLS server identity: the mirror image of the three vars above,
# but for the agent's own HTTPS listener rather than the API's outbound
# client (Phase 1.6a)
NEBULA_AGENT_TLS_CERT_FILE=/run/nebula-secrets/agent_tls_cert
NEBULA_AGENT_TLS_KEY_FILE=/run/nebula-secrets/agent_tls_key
NEBULA_AGENT_TRUSTED_CLIENT_CA_FILE=/run/nebula-secrets/agent_trusted_client_ca

# Agent listener binding: 0.0.0.0 is dev-container-safe (see deploy/README.md
# for why real deployment must override this to a loopback/private address)
NEBULA_AGENT_BIND_HOST=0.0.0.0
NEBULA_AGENT_BIND_PORT=9443

# WireGuard agent (host-side only)
NEBULA_WG_INTERFACE=wg0
NEBULA_WG_SERVER_PRIVATE_KEY_FILE=/run/nebula-secrets/wireguard_server_private_key
NEBULA_WG_BINARY=/usr/bin/wg
NEBULA_WG_QUICK_BINARY=/usr/bin/wg-quick
NEBULA_WG_STATE_DIR=/var/lib/nebula/wireguard
NEBULA_WG_DRIVER=fake
NEBULA_WG_SERVER_ADDRESS=10.77.0.1/24
NEBULA_WG_CLIENT_POOL=10.77.0.0/24
NEBULA_WG_LISTEN_PORT=51820
NEBULA_WG_PUBLIC_ENDPOINT=vpn.example.com:51820
NEBULA_WG_CLIENT_DNS=1.1.1.1
NEBULA_WG_CLIENT_ALLOWED_IPS=0.0.0.0/0,::/0
NEBULA_WG_PERSISTENT_KEEPALIVE_SECONDS=25
NEBULA_OPERATION_LEDGER_FILE=/var/lib/nebula/wireguard/operation_ledger.jsonl

# Xray agent (disabled until the Xray delivery phase)
NEBULA_XRAY_ENABLED=false
NEBULA_XRAY_BINARY=/usr/local/bin/xray
NEBULA_XRAY_CONFIG_DIR=/etc/nebula/xray
NEBULA_XRAY_STATE_DIR=/var/lib/nebula/xray
NEBULA_XRAY_PUBLIC_HOST=xray.example.com
NEBULA_XRAY_TLS_CERT_FILE=/run/nebula-secrets/xray_tls_cert
NEBULA_XRAY_TLS_KEY_FILE=/run/nebula-secrets/xray_tls_key
NEBULA_XRAY_VALIDATE_TIMEOUT_SECONDS=10
NEBULA_XRAY_APPLY_TIMEOUT_SECONDS=20
NEBULA_XRAY_LOG_LEVEL=warning
NEBULA_XRAY_ACCESS_LOG=none

# Reverse proxy and TLS
NEBULA_DOMAIN=vpn.example.com
NEBULA_ACME_EMAIL=ops@example.com

# Retention and operational limits
NEBULA_AUDIT_RETENTION_DAYS=365
NEBULA_AUTH_LOG_RETENTION_DAYS=90
NEBULA_EMAIL_RETENTION_DAYS=90
NEBULA_MAX_REQUEST_BYTES=1048576

# Encrypted, off-host backups
NEBULA_BACKUP_SCHEDULE=0 2 * * *
NEBULA_BACKUP_RETENTION_DAYS=30
NEBULA_BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
NEBULA_BACKUP_REMOTE=
